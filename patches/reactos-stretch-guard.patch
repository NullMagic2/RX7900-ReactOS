+# Optional paired stretch admission preserves engine mirror orientation.
+option(RX7900_FRAMEBUFFER_STRETCH_GUARD "Preserve Lightning stretch orientation" OFF)
+set(RX7900_FRAMEBUFFER_STRETCH_GUARD_SOURCE "" CACHE PATH "RX7900 native C++ source directory")
+if(RX7900_FRAMEBUFFER_STRETCH_GUARD)
+    get_filename_component(rx7900_stretch_shared
+        "${RX7900_FRAMEBUFFER_STRETCH_GUARD_SOURCE}/../../third_party/qemu_lightning" ABSOLUTE)
+    if(NOT EXISTS "${RX7900_FRAMEBUFFER_STRETCH_GUARD_SOURCE}/framebuffer_stretch_guard.cpp" OR
+       NOT EXISTS "${rx7900_stretch_shared}/lightning-display.h")
+        message(FATAL_ERROR "RX7900_FRAMEBUFFER_STRETCH_GUARD_SOURCE must select the complete RX7900 source")
+    endif()
+    target_sources(win32k PRIVATE "${RX7900_FRAMEBUFFER_STRETCH_GUARD_SOURCE}/framebuffer_stretch_guard.cpp" "${RX7900_FRAMEBUFFER_STRETCH_GUARD_SOURCE}/framebuffer_engine_sync.cpp")
+    target_include_directories(win32k PRIVATE "${RX7900_FRAMEBUFFER_STRETCH_GUARD_SOURCE}"
+        "${rx7900_stretch_shared}")
+    target_compile_definitions(win32k PRIVATE RX7900_FRAMEBUFFER_STRETCH_GUARD)
+    set_target_properties(win32k PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED YES
+        WITH_CXX_EXCEPTIONS FALSE WITH_CXX_RTTI FALSE)
+endif()
