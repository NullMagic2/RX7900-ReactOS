diff --git a/win32ss/drivers/displays/framebuf/CMakeLists.txt b/win32ss/drivers/displays/framebuf/CMakeLists.txt
index 6b084b1..86ca7fe 100644
--- a/win32ss/drivers/displays/framebuf/CMakeLists.txt
+++ b/win32ss/drivers/displays/framebuf/CMakeLists.txt
@@ -7,11 +7,30 @@ list(APPEND SOURCE
     surface.c
     framebuf.h)
 
+# Optional C++ cached framebuffer adapter. Source ownership stays in RX7900;
+# other formats and default ReactOS configurations keep the original path.
+option(RX7900_FRAMEBUFFER_SHADOW "Use cached 32bpp framebuf drawing" OFF)
+set(RX7900_FRAMEBUFFER_SHADOW_SOURCE "" CACHE PATH "RX7900 native C++ source directory")
+if(RX7900_FRAMEBUFFER_SHADOW)
+    if(NOT EXISTS "${RX7900_FRAMEBUFFER_SHADOW_SOURCE}/framebuffer_shadow.cpp")
+        message(FATAL_ERROR "RX7900_FRAMEBUFFER_SHADOW_SOURCE must contain framebuffer_shadow.cpp")
+    endif()
+    list(APPEND SOURCE "${RX7900_FRAMEBUFFER_SHADOW_SOURCE}/framebuffer_shadow.cpp")
+endif()
+
 add_library(framebuf MODULE
     ${SOURCE}
     framebuf.rc)
 
 set_module_type(framebuf kerneldll ENTRYPOINT DrvEnableDriver 12)
+if(RX7900_FRAMEBUFFER_SHADOW)
+    target_include_directories(framebuf PRIVATE "${RX7900_FRAMEBUFFER_SHADOW_SOURCE}")
+    target_compile_definitions(framebuf PRIVATE RX7900_FRAMEBUFFER_SHADOW)
+    set_target_properties(framebuf PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED YES CXX_EXTENSIONS NO)
+    if(NOT MSVC)
+        target_compile_options(framebuf PRIVATE $<$<COMPILE_LANGUAGE:CXX>:-fno-exceptions;-fno-rtti>)
+    endif()
+endif()
 add_pch(framebuf framebuf.h SOURCE)
 target_link_libraries(framebuf libcntpr)
 add_importlibs(framebuf win32k)
