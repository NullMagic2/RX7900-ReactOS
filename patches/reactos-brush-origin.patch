diff --git a/win32ss/CMakeLists.txt b/win32ss/CMakeLists.txt
index 3e2f3d2..833ead1 100644
--- a/win32ss/CMakeLists.txt
+++ b/win32ss/CMakeLists.txt
@@ -319,6 +319,20 @@ endif()
 add_importlibs(win32k ntoskrnl hal ftfd)
 add_cd_file(TARGET win32k DESTINATION reactos/system32 FOR all)
 
+# Optional checked device brush origins use the current locked DC attributes.
+option(RX7900_FRAMEBUFFER_BRUSH_ORIGIN "Translate current DC brush origins safely" OFF)
+set(RX7900_FRAMEBUFFER_BRUSH_ORIGIN_SOURCE "" CACHE PATH "RX7900 native C++ source directory")
+if(RX7900_FRAMEBUFFER_BRUSH_ORIGIN)
+    if(NOT EXISTS "${RX7900_FRAMEBUFFER_BRUSH_ORIGIN_SOURCE}/framebuffer_brush_origin.cpp")
+        message(FATAL_ERROR "RX7900_FRAMEBUFFER_BRUSH_ORIGIN_SOURCE must contain framebuffer_brush_origin.cpp")
+    endif()
+    target_sources(win32k PRIVATE "${RX7900_FRAMEBUFFER_BRUSH_ORIGIN_SOURCE}/framebuffer_brush_origin.cpp")
+    target_include_directories(win32k PRIVATE "${RX7900_FRAMEBUFFER_BRUSH_ORIGIN_SOURCE}")
+    target_compile_definitions(win32k PRIVATE RX7900_FRAMEBUFFER_BRUSH_ORIGIN)
+    set_target_properties(win32k PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED YES
+        WITH_CXX_EXCEPTIONS FALSE WITH_CXX_RTTI FALSE)
+endif()
+
 if(ARCH STREQUAL "amd64")
     set_source_files_properties(sys-stubs.S PROPERTIES OBJECT_DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/w32ksvc64.h)
 else()
