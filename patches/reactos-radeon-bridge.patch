+#ifdef RX7900_RADEON_BRIDGE
+/* Present one styled cosmetic segment to an identified radeondisp
+ * DrvStrokePath. The path, its data and points live on this stack frame for
+ * the synchronous driver call only. FALSE leaves IntEngLineTo's original
+ * DrvLineTo/EngLineTo path completely unchanged. */
+static DECLSPEC_NOINLINE BOOL
+Rx7900RadeonStrokeSegment(SURFOBJ *psoDest,
+                          CLIPOBJ *ClipObj,
+                          BRUSHOBJ *pbo,
+                          PBRUSH pbrush,
+                          LONG x1,
+                          LONG y1,
+                          LONG x2,
+                          LONG y2,
+                          MIX Mix)
+{
+    RX7900_RADEON_STROKE Stroke;
+    EXTPATHDATA PathData;
+    PATH Path;
+    EPATHOBJ PathObj;
+
+    if (!Rx7900RadeonStrokePrepare(&Stroke, psoDest, GDIDEVFUNCS(psoDest).Escape,
+                                   ClipObj, Mix, x1, y1, x2, y2,
+                                   pbrush->dwStyleCount, pbrush->pStyle))
+    {
+        return FALSE;
+    }
+
+    RtlZeroMemory(&PathData, sizeof(PathData));
+    RtlZeroMemory(&Path, sizeof(Path));
+    RtlZeroMemory(&PathObj, sizeof(PathObj));
+    PathData.pd.flags = PD_BEGINSUBPATH | PD_ENDSUBPATH;
+    PathData.pd.count = 2;
+    PathData.pd.pptfx = Stroke.points;
+    Path.flType = PATHTYPE_STACK;
+    Path.ppdFirst = &PathData;
+    Path.ppdLast = &PathData;
+    Path.ppdCurrent = &PathData;
+    Path.cCurves = 1;
+    Path.epo = &PathObj;
+    PathObj.po.fl = PO_ALL_INTEGERS;
+    PathObj.po.cCurves = 1;
+    PathObj.pPath = &Path;
+    return Rx7900RadeonStrokeDraw(&Stroke, GDIDEVFUNCS(psoDest).StrokePath, psoDest,
+                                  &PathObj.po, ClipObj, pbo);
+}
+#endif
