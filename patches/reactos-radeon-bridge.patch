+# Optional paired caller bridge offers a positively identified physical
+# radeondisp surface its DrvStrokePath for styled cosmetic segments. Every
+# other driver, engine bitmap and declined call keeps the original path.
+option(RX7900_RADEON_BRIDGE "Offer styled cosmetic lines to radeondisp DrvStrokePath" OFF)
+set(RX7900_RADEON_BRIDGE_SOURCE "" CACHE PATH "RX7900 native C++ source directory")
+if(RX7900_RADEON_BRIDGE)
+    if(NOT EXISTS "${RX7900_RADEON_BRIDGE_SOURCE}/radeon_bridge.cpp" OR
+       NOT EXISTS "${RX7900_RADEON_BRIDGE_SOURCE}/radeon_line_identity.hpp" OR
+       NOT EXISTS "${RX7900_RADEON_BRIDGE_SOURCE}/framebuffer_stretch_guard.hpp")
+        message(FATAL_ERROR "RX7900_RADEON_BRIDGE_SOURCE must contain the paired Radeon caller bridge")
+    endif()
+    target_sources(win32k PRIVATE "${RX7900_RADEON_BRIDGE_SOURCE}/radeon_bridge.cpp")
+    target_include_directories(win32k PRIVATE "${RX7900_RADEON_BRIDGE_SOURCE}")
+    target_compile_definitions(win32k PRIVATE RX7900_RADEON_BRIDGE)
+    set_target_properties(win32k PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED YES
+        WITH_CXX_EXCEPTIONS FALSE WITH_CXX_RTTI FALSE)
+endif()
 
