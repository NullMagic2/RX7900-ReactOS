--- a/win32ss/CMakeLists.txt
+++ b/win32ss/CMakeLists.txt
@@ -265,4 +265,19 @@
 
+# Optional cursor recovery reselects the engine-owned original shape after a
+# positively identified Lightning movement failure. Other drivers are unchanged.
+option(RX7900_FRAMEBUFFER_CURSOR_RECOVERY "Recover failed Lightning cursor moves" OFF)
+set(RX7900_FRAMEBUFFER_CURSOR_RECOVERY_SOURCE "" CACHE PATH "RX7900 native C++ source directory")
+if(RX7900_FRAMEBUFFER_CURSOR_RECOVERY)
+    if(NOT EXISTS "${RX7900_FRAMEBUFFER_CURSOR_RECOVERY_SOURCE}/framebuffer_cursor_recovery.cpp")
+        message(FATAL_ERROR "RX7900_FRAMEBUFFER_CURSOR_RECOVERY_SOURCE must contain framebuffer_cursor_recovery.cpp")
+    endif()
+    target_sources(win32k PRIVATE "${RX7900_FRAMEBUFFER_CURSOR_RECOVERY_SOURCE}/framebuffer_cursor_recovery.cpp")
+    target_include_directories(win32k PRIVATE "${RX7900_FRAMEBUFFER_CURSOR_RECOVERY_SOURCE}")
+    target_compile_definitions(win32k PRIVATE RX7900_FRAMEBUFFER_CURSOR_RECOVERY)
+    set_target_properties(win32k PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED YES
+        WITH_CXX_EXCEPTIONS FALSE WITH_CXX_RTTI FALSE)
+endif()
+
 if(USE_DIBLIB)
     target_link_libraries(win32k diblib)
 endif()
