+# Optional engine text batching reuses the RX7900 cached surface through a
+# kernel-only notification; default ReactOS rendering is unchanged.
+option(RX7900_FRAMEBUFFER_TEXT_BATCH "Batch glyph uploads for Lightning GDI" OFF)
+set(RX7900_FRAMEBUFFER_TEXT_BATCH_SOURCE "" CACHE PATH "RX7900 native C++ source directory")
+if(RX7900_FRAMEBUFFER_TEXT_BATCH)
+    if(NOT EXISTS "${RX7900_FRAMEBUFFER_TEXT_BATCH_SOURCE}/framebuffer_text_batch.cpp")
+        message(FATAL_ERROR "RX7900_FRAMEBUFFER_TEXT_BATCH_SOURCE must contain framebuffer_text_batch.cpp")
+    endif()
+    target_sources(win32k PRIVATE "${RX7900_FRAMEBUFFER_TEXT_BATCH_SOURCE}/framebuffer_text_batch.cpp")
+    target_include_directories(win32k PRIVATE "${RX7900_FRAMEBUFFER_TEXT_BATCH_SOURCE}")
+    target_compile_definitions(win32k PRIVATE RX7900_FRAMEBUFFER_TEXT_BATCH)
+    set_target_properties(win32k PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED YES
+        WITH_CXX_EXCEPTIONS FALSE WITH_CXX_RTTI FALSE)
+endif()
