+/*
+Module: reactos.pci.resource_snapshot
+Purpose: Build PnP lists from one checked immutable BAR capture, without reprobes.
+Created: 2026-10-21
+Architecture: C++17 native resource ownership; BAR policy validates all narrowing.
+Adapted from ReactOS pdo.c by Casper S. Hornstrup, created 2001-10-09.
+License: ReactOS GPL; see COPYING in the ReactOS source root.
+*/
+#include "bar_probe_native.hpp"
+#include "bar_probe.h"
+
+namespace {
+
+class PoolOwner final {
+public:
+    explicit PoolOwner(ULONG bytes) noexcept
+        : pointer_(ExAllocatePoolWithTag(PagedPool, bytes, TAG_PCI)) {
+        if (pointer_ != nullptr) {
+            RtlZeroMemory(pointer_, bytes);
+        }
+    }
+    ~PoolOwner() {
+        if (pointer_ != nullptr) {
+            ExFreePoolWithTag(pointer_, TAG_PCI);
+        }
+    }
+    PoolOwner(const PoolOwner&) = delete;
+    PoolOwner& operator=(const PoolOwner&) = delete;
+    void* get() const noexcept { return pointer_; }
+    ULONG_PTR publish() noexcept {
+        const ULONG_PTR result = reinterpret_cast<ULONG_PTR>(pointer_);
+        pointer_ = nullptr;
+        return result;
+    }
+private:
+    void* pointer_;
+};
+
+USHORT memory_flags(const pci::BarRange& range) noexcept {
+    return static_cast<USHORT>(CM_RESOURCE_MEMORY_READ_WRITE |
+        ((range.flags & PCI_ADDRESS_MEMORY_PREFETCHABLE) != 0 ?
+            CM_RESOURCE_MEMORY_PREFETCHABLE : 0));
+}
+
+bool is_bridge(const pci::ResourceSnapshot& snapshot) noexcept {
+    return PCI_CONFIGURATION_TYPE(&snapshot.config) == PCI_BRIDGE_TYPE &&
+           snapshot.config.BaseClass == PCI_CLASS_BRIDGE_DEV;
+}
+
+bool has_interrupt(const pci::ResourceSnapshot& snapshot, bool requirements) noexcept {
+    return PCI_CONFIGURATION_TYPE(&snapshot.config) == PCI_DEVICE_TYPE &&
+           snapshot.config.u.type0.InterruptPin != 0 &&
+           (requirements || (snapshot.config.u.type0.InterruptLine != 0 &&
+                             snapshot.config.u.type0.InterruptLine != 0xff));
+}
+
+// Snapshot proves ULONG Length/Alignment and Base+Length-1 before allocation.
+// Both count and writes consume the exact same capture; there is no second I/O
+// pass that can discover more descriptors than the allocated output holds.
+void fill_requirement(IO_RESOURCE_DESCRIPTOR& descriptor, const pci::BarRange& range,
+                       bool alternative) noexcept {
+    descriptor.Option = alternative ? IO_RESOURCE_ALTERNATIVE : IO_RESOURCE_PREFERRED;
+    descriptor.ShareDisposition = CmResourceShareDeviceExclusive;
+    const ULONG length = static_cast<ULONG>(range.length);
+    const LONGLONG minimum = alternative ? 0 : static_cast<LONGLONG>(range.base);
+    const LONGLONG maximum = static_cast<LONGLONG>(alternative ? range.maximum_address :
+                                                   range.base + range.length - 1u);
+
+    if ((range.flags & PCI_ADDRESS_IO_SPACE) != 0) {
+        descriptor.Type = CmResourceTypePort;
+        descriptor.Flags = CM_RESOURCE_PORT_IO | CM_RESOURCE_PORT_16_BIT_DECODE |
+                           CM_RESOURCE_PORT_POSITIVE_DECODE;
+        descriptor.u.Port.Length = length;
+        descriptor.u.Port.Alignment = alternative ? length : 1;
+        descriptor.u.Port.MinimumAddress.QuadPart = minimum;
+        descriptor.u.Port.MaximumAddress.QuadPart = maximum;
+    } else {
+        descriptor.Type = CmResourceTypeMemory;
+        descriptor.Flags = memory_flags(range);
+        descriptor.u.Memory.Length = length;
+        descriptor.u.Memory.Alignment = alternative ? length : 1;
+        descriptor.u.Memory.MinimumAddress.QuadPart = minimum;
+        descriptor.u.Memory.MaximumAddress.QuadPart = maximum;
+    }
+}
