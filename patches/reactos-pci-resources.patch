+/*
+Module: reactos.pci.bar_probe_native
+Purpose: Share one device-owned capture between native resource builders.
+Created: 2026-10-21
+Architecture: Resident capture; allocation/filling happens after config unlock.
+*/
+#pragma once
+#include "pci.h"
+#include "bar_probe_policy.hpp"
+namespace pci {
+struct ResourceSnapshot final {
+    PCI_COMMON_CONFIG config{};
+    BarSnapshot bars{};
+};
+NTSTATUS capture_resources(PPDO_DEVICE_EXTENSION device, ResourceSnapshot& output) noexcept;
+} // namespace pci
diff --git a/drivers/bus/pci/bar_probe_policy.cpp b/drivers/bus/pci/bar_probe_policy.cpp
new file mode 100644
index 0000000..9456935
--- /dev/null
+++ b/drivers/bus/pci/bar_probe_policy.cpp
@@ -0,0 +1,168 @@
+/*
+Module: reactos.pci.bar_probe_policy
+Purpose: Restore PCI BAR and decode state across sizing and I/O failures.
+Created: 2026-10-21
+Architecture: No native pointers, allocation, exceptions or platform runtime.
+*/
+#include "bar_probe_policy.hpp"
+
+namespace pci {
+namespace {
+constexpr uint16_t decode_mask = 3; // PCI command I/O-space and memory-space enable.
+constexpr uint32_t sizing_value = UINT32_MAX;
+
+bool command_is(ProbeAccess access, uint16_t expected) noexcept {
+    uint16_t observed = 0;
+    return access.read_command(access.context, observed) && observed == expected;
+}
+
+bool restore_command(ProbeAccess access, uint16_t command) noexcept {
+    return access.write_command(access.context, command) && command_is(access, command);
+}
+} // namespace
+
+ProbeStatus probe_bar(ProbeAccess access, ProbeValue& output) noexcept {
+    if (access.read_command == nullptr || access.write_command == nullptr ||
+        access.read_bar == nullptr || access.write_bar == nullptr) {
+        return ProbeStatus::invalid_access;
+    }
+
+    ProbeValue candidate{};
+    uint16_t original_command = 0;
+
+    if (!access.read_bar(access.context, candidate.original) ||
+        !access.read_command(access.context, original_command)) {
+        return ProbeStatus::read_failed;
+    }
+
+    const uint16_t disabled = static_cast<uint16_t>(original_command & ~decode_mask);
+
+    if (original_command != disabled) {
+        if (!access.write_command(access.context, disabled) || !command_is(access, disabled)) {
+            // BAR was never touched. Restore command even after a partial write.
+            return restore_command(access, original_command) ? ProbeStatus::disable_failed :
+                                                               ProbeStatus::restore_failed;
+        }
+    }
+
+    const bool probed = access.write_bar(access.context, sizing_value) &&
+                        access.read_bar(access.context, candidate.mask);
+    uint32_t restored_bar = 0;
+
+    // A failed/partial sizing write may still have changed the BAR. Restore it
+    // on both success and failure, before re-enabling either decode bit.
+    if (!access.write_bar(access.context, candidate.original) ||
+        !access.read_bar(access.context, restored_bar) || restored_bar != candidate.original) {
+        return ProbeStatus::restore_failed;
+    }
+
+    if (original_command != disabled && !restore_command(access, original_command)) {
+        return ProbeStatus::restore_failed;
+    }
+    if (!probed) {
+        return ProbeStatus::probe_failed;
+    }
+
+    output = candidate;
+    return ProbeStatus::success;
+}
+
+SnapshotStatus capture_bars(SnapshotAccess access, uint8_t header_type,
+                            BarSnapshot& output) noexcept {
+    if (access.probe == nullptr) {
+        return SnapshotStatus::invalid_access;
+    }
+
+    const uint32_t limit = header_type == 0 ? 6u : header_type == 1 ? 2u : 0u;
+
+    if (limit == 0) {
+        return SnapshotStatus::unsupported_header;
+    }
+
+    BarSnapshot candidate{};
+
+    for (uint32_t bar = 0; bar < limit;) {
+        const uint32_t first = bar;
+        ProbeValue low{};
+
+        if (access.probe(access.context, bar++, low) != ProbeStatus::success) {
+            return SnapshotStatus::probe_failed;
+        }
+
+        const bool io = (low.original & 1u) != 0;
+        const uint32_t type = low.original & 6u;
+        uint64_t original = low.original;
+        uint64_t mask = low.mask;
+        uint64_t address_mask = io ? 0xfffffffcu : 0xfffffff0u;
+        uint64_t maximum_address = UINT32_MAX;
+        const uint32_t flags_mask = io ? 3u : 15u;
+
+        if (!io && type == 4u) {
+            if (bar == limit) {
+                return SnapshotStatus::invalid_bar;
+            }
+
+            ProbeValue high{};
+
+            if (access.probe(access.context, bar++, high) != ProbeStatus::success) {
+                return SnapshotStatus::probe_failed;
+            }
+
+            original |= static_cast<uint64_t>(high.original) << 32;
+            mask |= static_cast<uint64_t>(high.mask) << 32;
+            address_mask = UINT64_MAX & ~uint64_t{15};
+            maximum_address = UINT64_MAX;
+        } else if (!io && type == 2u) {
+            address_mask = 0x000ffff0u;
+            maximum_address = 0x000fffffu;
+        } else if (!io && type != 0) {
+            return SnapshotStatus::invalid_bar;
+        } else if (io && (mask & 0xffff0000u) == 0 && (original & 0xffff0000u) == 0) {
+            address_mask = 0x0000fffcu;
+            maximum_address = 0x0000ffffu;
+        }
+
+        if (mask == 0) {
+            continue; // Unimplemented BAR, never a descriptor.
+        }
+
+        if ((low.mask & flags_mask) != (low.original & flags_mask) ||
+            (original & ~(address_mask | flags_mask)) != 0) {
+            return SnapshotStatus::invalid_bar;
+        }
+
+        const uint64_t address_bits = mask & address_mask;
+
+        if (address_bits == 0) {
+            return SnapshotStatus::length_unrepresentable;
+        }
+
+        const uint64_t length = address_bits & (~address_bits + 1u);
+
+        if (length > UINT32_MAX) {
+            return SnapshotStatus::length_unrepresentable;
+        }
+
+        if (address_bits != (address_mask & ~(length - 1u))) {
+            return SnapshotStatus::invalid_bar;
+        }
+
+        const uint64_t base = original & address_mask;
+
+        if (length - 1u > UINT64_MAX - base || base + length - 1u > maximum_address) {
+            return SnapshotStatus::address_overflow;
+        }
+
+        if ((base & (length - 1u)) != 0) {
+            return SnapshotStatus::invalid_bar;
+        }
+
+        candidate.ranges[candidate.count] = BarRange{base, length, maximum_address,
+            low.original & flags_mask, static_cast<uint8_t>(first)};
+        ++candidate.count;
+    }
+
+    output = candidate;
+    return SnapshotStatus::success;
+}
+} // namespace pci
diff --git a/drivers/bus/pci/bar_probe_policy.hpp b/drivers/bus/pci/bar_probe_policy.hpp
new file mode 100644
index 0000000..babc624
--- /dev/null
+++ b/drivers/bus/pci/bar_probe_policy.hpp
@@ -0,0 +1,68 @@
+/*
+Module: reactos.pci.bar_probe_policy
+Purpose: Size a PCI BAR without decoding transient probe addresses.
+Created: 2026-10-21
+Architecture: Allocation-free C++17 transaction; native HAL owns config access.
+*/
+#pragma once
+#include <stdint.h>
+
+namespace pci {
+
+struct ProbeAccess final {
+    void* context;
+    bool (*read_command)(void*, uint16_t&) noexcept;
+    bool (*write_command)(void*, uint16_t) noexcept;
+    bool (*read_bar)(void*, uint32_t&) noexcept;
+    bool (*write_bar)(void*, uint32_t) noexcept;
+};
+
+enum class ProbeStatus { success, invalid_access, read_failed, disable_failed,
+                         probe_failed, restore_failed };
+struct ProbeValue final { uint32_t original; uint32_t mask; };
+
+// Caller serializes access to this function's PCI configuration registers.
+// The borrowed callback context remains valid until return. Both decode bits
+// are disabled and read back before the sizing write. A failed BAR restore
+// leaves decoding disabled; failure never publishes a partially read result.
+ProbeStatus probe_bar(ProbeAccess access, ProbeValue& output) noexcept;
+
+constexpr uint32_t bar_capacity = 6;
+struct BarRange final {
+    uint64_t base;
+    uint64_t length;
+    uint64_t maximum_address;
+    uint32_t flags;
+    uint8_t first_bar;
+};
+
+struct BarSnapshot final {
+    BarRange ranges[bar_capacity]{};
+    uint32_t count = 0;
+};
+
+struct SnapshotAccess final {
+    void* context;
+    ProbeStatus (*probe)(void*, uint32_t bar, ProbeValue&) noexcept;
+};
+
+enum class SnapshotStatus {
+    success,
+    invalid_access,
+    unsupported_header,
+    probe_failed,
+    invalid_bar,
+    length_unrepresentable,
+    address_overflow
+};
+
+// One immutable capture supplies both descriptor counting and filling. Caller
+// holds config serialization across header acquisition and this entire call.
+// Type0 has six BARs, type1 two; other headers are explicitly unsupported. Each
+// DWORD is probed once. Failure leaves output unchanged, never a partial prefix.
+// CM/IO descriptors here have only 32-bit Length/Alignment; larger regions fail
+// rather than truncating into a different resource. CM MemoryLarge is not added.
+SnapshotStatus capture_bars(SnapshotAccess access, uint8_t header_type,
+                            BarSnapshot& output) noexcept;
+
+} // namespace pci
