diff --git a/drivers/bus/pci/bar_probe.cpp b/drivers/bus/pci/bar_probe.cpp
new file mode 100644
index 0000000..2955041
--- /dev/null
+++ b/drivers/bus/pci/bar_probe.cpp
@@ -0,0 +1,126 @@
+/*
+Module: reactos.pci.bar_probe
+Purpose: Perform exact-width HAL configuration reads for safe BAR sizing.
+Created: 2026-10-21
+Architecture: C++17 native boundary; pure policy owns rollback and publication.
+*/
+#include "pci.h"
+#include "bar_probe.h"
+#include "bar_probe_policy.hpp"
+#include "bar_probe_native.hpp"
+
+namespace {
+constexpr ULONG command_offset = 4;
+constexpr ULONG first_bar_offset = 0x10;
+KSPIN_LOCK config_lock;
+
+// Config BUS_INTERFACE callbacks may run through DIRQL. A DPC-only gate could
+// deadlock if a same-CPU ISR reader preempted a sizing transaction. All native
+// PCI-driver config paths take this HIGH_LEVEL gate before HAL's separate lock.
+// No allocation, logging or pageable storage is accessed while it is held.
+class ConfigGuard final {
+public:
+    ConfigGuard() noexcept {
+        KeRaiseIrql(HIGH_LEVEL, &previous_);
+        KeAcquireSpinLockAtDpcLevel(&config_lock);
+    }
+    ~ConfigGuard() {
+        KeReleaseSpinLockFromDpcLevel(&config_lock);
+        KeLowerIrql(previous_);
+    }
+    ConfigGuard(const ConfigGuard&) = delete;
+    ConfigGuard& operator=(const ConfigGuard&) = delete;
+private:
+    KIRQL previous_{};
+};
+struct ConfigLocation final { ULONG bus; ULONG slot; ULONG bar; };
+
+bool read_command(void* context, uint16_t& value) noexcept {
+    const auto& location = *static_cast<const ConfigLocation*>(context);
+    USHORT native = 0;
+    const ULONG bytes = HalGetBusDataByOffset(PCIConfiguration, location.bus,
+        location.slot, &native, command_offset, sizeof(native));
+    value = native;
+    return bytes == sizeof(native);
+}
+
+bool write_command(void* context, uint16_t value) noexcept {
+    const auto& location = *static_cast<const ConfigLocation*>(context);
+    USHORT native = value;
+    return HalSetBusDataByOffset(PCIConfiguration, location.bus, location.slot,
+        &native, command_offset, sizeof(native)) == sizeof(native);
+}
+
+bool read_bar(void* context, uint32_t& value) noexcept {
+    const auto& location = *static_cast<const ConfigLocation*>(context);
+    ULONG native = 0;
+    const ULONG bytes = HalGetBusDataByOffset(PCIConfiguration, location.bus,
+        location.slot, &native, location.bar, sizeof(native));
+    value = native;
+    return bytes == sizeof(native);
+}
+
+bool write_bar(void* context, uint32_t value) noexcept {
+    const auto& location = *static_cast<const ConfigLocation*>(context);
+    ULONG native = value;
+    return HalSetBusDataByOffset(PCIConfiguration, location.bus, location.slot,
+        &native, location.bar, sizeof(native)) == sizeof(native);
+}
+pci::ProbeStatus probe_dword(void* context, uint32_t index,
+                             pci::ProbeValue& output) noexcept {
+    auto& location = *static_cast<ConfigLocation*>(context);
+    location.bar = first_bar_offset + index * static_cast<ULONG>(sizeof(ULONG));
+    return pci::probe_bar({&location, read_command, write_command, read_bar, write_bar}, output);
+}
+} // namespace
+
+extern "C" VOID NTAPI PciInitializeConfigAccess(VOID) {
+    KeInitializeSpinLock(&config_lock);
+}
+
+extern "C" ULONG NTAPI PciReadConfig(ULONG bus, ULONG slot, PVOID buffer,
+                                    ULONG offset, ULONG bytes) {
+    if (buffer == nullptr || bytes == 0 || bytes > MAXULONG - offset) {
+        return 0;
+    }
+    ConfigGuard transaction;
+    return HalGetBusDataByOffset(PCIConfiguration, bus, slot, buffer, offset, bytes);
+}
+
+extern "C" ULONG NTAPI PciWriteConfig(ULONG bus, ULONG slot, PVOID buffer,
+                                     ULONG offset, ULONG bytes) {
+    if (buffer == nullptr || bytes == 0 || bytes > MAXULONG - offset) {
+        return 0;
+    }
+    ConfigGuard transaction;
+    return HalSetBusDataByOffset(PCIConfiguration, bus, slot, buffer, offset, bytes);
+}
+
+NTSTATUS pci::capture_resources(PPDO_DEVICE_EXTENSION device,
+                                ResourceSnapshot& output) noexcept {
+    ResourceSnapshot candidate{};
+    SnapshotStatus status{};
+    {
+        ConfigGuard transaction;
+        ConfigLocation location{device->PciDevice->BusNumber,
+            device->PciDevice->SlotNumber.u.AsULONG, first_bar_offset};
+        if (HalGetBusDataByOffset(PCIConfiguration, location.bus, location.slot,
+            &candidate.config, 0, PCI_COMMON_HDR_LENGTH) != PCI_COMMON_HDR_LENGTH) {
+            return STATUS_UNSUCCESSFUL;
+        }
+        if (candidate.config.VendorID == 0 || candidate.config.VendorID == PCI_INVALID_VENDORID) {
+            return STATUS_NO_SUCH_DEVICE;
+        }
+        status = capture_bars({&location, probe_dword},
+            PCI_CONFIGURATION_TYPE(&candidate.config), candidate.bars);
+    }
+    if (status == SnapshotStatus::unsupported_header ||
+        status == SnapshotStatus::length_unrepresentable) {
+        return STATUS_NOT_SUPPORTED;
+    }
+    if (status != SnapshotStatus::success) {
+        return STATUS_DEVICE_CONFIGURATION_ERROR;
+    }
+    output = candidate;
+    return STATUS_SUCCESS;
+}
