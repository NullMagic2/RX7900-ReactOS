+} // namespace
+
+// PnP/PASSIVE_LEVEL. Caller owns the PDO and writable Information field. These
+// routines return an owned paged-pool native list to PnP on success only. Failure
+// frees every allocation, publishes no list and changes no device-enable flags.
+extern "C" NTSTATUS NTAPI PciQueryResourceRequirements(PVOID extension,
+                                                       PULONG_PTR information) {
+    auto* device = static_cast<PPDO_DEVICE_EXTENSION>(extension);
+    *information = 0;
+    pci::ResourceSnapshot snapshot{};
+    const NTSTATUS status = pci::capture_resources(device, snapshot);
+
+    if (!NT_SUCCESS(status)) {
+        return status;
+    }
+
+    const bool irq = has_interrupt(snapshot, true);
+    const bool bridge = is_bridge(snapshot);
+    const ULONG count = snapshot.bars.count * 2u + (irq || bridge ? 1u : 0u);
+
+    if (count == 0) {
+        return STATUS_SUCCESS;
+    }
+
+    const ULONG bytes = FIELD_OFFSET(IO_RESOURCE_REQUIREMENTS_LIST, List[0].Descriptors) +
+                        count * static_cast<ULONG>(sizeof(IO_RESOURCE_DESCRIPTOR));
+    PoolOwner allocation(bytes);
+    auto* resources = static_cast<PIO_RESOURCE_REQUIREMENTS_LIST>(allocation.get());
+
+    if (resources == nullptr) {
+        return STATUS_INSUFFICIENT_RESOURCES;
+    }
+
+    resources->ListSize = bytes;
+    resources->InterfaceType = PCIBus;
+    resources->BusNumber = device->PciDevice->BusNumber;
+    resources->SlotNumber = device->PciDevice->SlotNumber.u.AsULONG;
+    resources->AlternativeLists = 1;
+    resources->List[0].Version = 1;
+    resources->List[0].Revision = 1;
+    resources->List[0].Count = count;
+    ULONG next = 0;
+
+    for (uint32_t index = 0; index < snapshot.bars.count; ++index) {
+        const auto& range = snapshot.bars.ranges[index];
+        fill_requirement(resources->List[0].Descriptors[next++], range, false);
+        fill_requirement(resources->List[0].Descriptors[next++], range, true);
+    }
+
+    if (irq) {
+        auto& descriptor = resources->List[0].Descriptors[next++];
+        descriptor.Type = CmResourceTypeInterrupt;
+        descriptor.ShareDisposition = CmResourceShareShared;
+        descriptor.Flags = CM_RESOURCE_INTERRUPT_LEVEL_SENSITIVE;
+        descriptor.u.Interrupt.MinimumVector = 0;
+        descriptor.u.Interrupt.MaximumVector = 0xff;
+    } else if (bridge) {
+        auto& descriptor = resources->List[0].Descriptors[next++];
+        descriptor.Type = CmResourceTypeBusNumber;
+        descriptor.ShareDisposition = CmResourceShareDeviceExclusive;
+        resources->BusNumber = snapshot.config.u.type1.SecondaryBus;
+        descriptor.u.BusNumber.MinBusNumber = snapshot.config.u.type1.SecondaryBus;
+        descriptor.u.BusNumber.MaxBusNumber = snapshot.config.u.type1.SecondaryBus;
+        descriptor.u.BusNumber.Length = 1;
+    }
+
+    if (next != count) {
+        return STATUS_INTERNAL_ERROR;
+    }
+
+    *information = allocation.publish();
+    return STATUS_SUCCESS;
+}
+
+extern "C" NTSTATUS NTAPI PciQueryResources(PVOID extension, PULONG_PTR information) {
+    auto* device = static_cast<PPDO_DEVICE_EXTENSION>(extension);
+    *information = 0;
+    pci::ResourceSnapshot snapshot{};
+    const NTSTATUS status = pci::capture_resources(device, snapshot);
+
+    if (!NT_SUCCESS(status)) {
+        return status;
+    }
+
+    const bool irq = has_interrupt(snapshot, false);
+    const bool bridge = is_bridge(snapshot);
+    const ULONG count = snapshot.bars.count + (irq || bridge ? 1u : 0u);
+
+    if (count == 0) {
+        return STATUS_SUCCESS;
+    }
+
+    const ULONG bytes = FIELD_OFFSET(CM_RESOURCE_LIST, List[0].PartialResourceList.PartialDescriptors) +
+                        count * static_cast<ULONG>(sizeof(CM_PARTIAL_RESOURCE_DESCRIPTOR));
+    PoolOwner allocation(bytes);
+    auto* resources = static_cast<PCM_RESOURCE_LIST>(allocation.get());
+
+    if (resources == nullptr) {
+        return STATUS_INSUFFICIENT_RESOURCES;
+    }
+
+    resources->Count = 1;
+    resources->List[0].InterfaceType = PCIBus;
+    resources->List[0].BusNumber = device->PciDevice->BusNumber;
+    auto& partial = resources->List[0].PartialResourceList;
+    partial.Version = 1;
+    partial.Revision = 1;
+    partial.Count = count;
+    ULONG next = 0;
+    bool memory = false;
+    bool io = false;
+
+    for (uint32_t index = 0; index < snapshot.bars.count; ++index) {
+        const auto& range = snapshot.bars.ranges[index];
+        auto& descriptor = partial.PartialDescriptors[next++];
+        descriptor.ShareDisposition = CmResourceShareDeviceExclusive;
+
+        if ((range.flags & PCI_ADDRESS_IO_SPACE) != 0) {
+            descriptor.Type = CmResourceTypePort;
+            descriptor.Flags = CM_RESOURCE_PORT_IO | CM_RESOURCE_PORT_16_BIT_DECODE |
+                               CM_RESOURCE_PORT_POSITIVE_DECODE;
+            descriptor.u.Port.Start.QuadPart = static_cast<LONGLONG>(range.base);
+            descriptor.u.Port.Length = static_cast<ULONG>(range.length);
+            io = true;
+        } else {
+            descriptor.Type = CmResourceTypeMemory;
+            descriptor.Flags = memory_flags(range);
+            descriptor.u.Memory.Start.QuadPart = static_cast<LONGLONG>(range.base);
+            descriptor.u.Memory.Length = static_cast<ULONG>(range.length);
+            memory = true;
+        }
+    }
+
+    if (irq) {
+        auto& descriptor = partial.PartialDescriptors[next++];
+        descriptor.Type = CmResourceTypeInterrupt;
+        descriptor.ShareDisposition = CmResourceShareShared;
+        descriptor.Flags = CM_RESOURCE_INTERRUPT_LEVEL_SENSITIVE;
+        descriptor.u.Interrupt.Level = snapshot.config.u.type0.InterruptLine;
+        descriptor.u.Interrupt.Vector = snapshot.config.u.type0.InterruptLine;
+        descriptor.u.Interrupt.Affinity = static_cast<KAFFINITY>(MAXULONG);
+    } else if (bridge) {
+        auto& descriptor = partial.PartialDescriptors[next++];
+        descriptor.Type = CmResourceTypeBusNumber;
+        descriptor.ShareDisposition = CmResourceShareDeviceExclusive;
+        resources->List[0].BusNumber = snapshot.config.u.type1.SecondaryBus;
+        descriptor.u.BusNumber.Start = snapshot.config.u.type1.SecondaryBus;
+        descriptor.u.BusNumber.Length = 1;
+    }
+
+    if (next != count) {
+        return STATUS_INTERNAL_ERROR;
+    }
+
+    device->PciDevice->EnableIoSpace = io ? TRUE : FALSE;
+    device->PciDevice->EnableMemorySpace = memory ? TRUE : FALSE;
+    if (PCI_CONFIGURATION_TYPE(&snapshot.config) == PCI_DEVICE_TYPE) {
+        device->PciDevice->EnableBusMaster = TRUE;
+    }
+    *information = allocation.publish();
+    return STATUS_SUCCESS;
+}
