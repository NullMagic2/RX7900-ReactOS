diff --git a/win32ss/CMakeLists.txt b/win32ss/CMakeLists.txt
index 3e2f3d2..e33be83 100644
--- a/win32ss/CMakeLists.txt
+++ b/win32ss/CMakeLists.txt
@@ -328,3 +328,26 @@ add_asm_files(win32ksys_asm sys-stubs.S)
 add_library(win32ksys ${win32ksys_asm})
 set_target_properties(win32ksys PROPERTIES LINKER_LANGUAGE "C")
 add_dependencies(win32ksys asm)
+
+# Optional explicit empty-region classification at the native DDI boundary.
+option(RX7900_FRAMEBUFFER_CLIP_VISIBILITY "Preserve updated empty visible regions" OFF)
+set(RX7900_FRAMEBUFFER_CLIP_VISIBILITY_SOURCE "" CACHE PATH "RX7900 native C++ source directory")
+if(RX7900_FRAMEBUFFER_CLIP_VISIBILITY)
+    if(NOT EXISTS "${RX7900_FRAMEBUFFER_CLIP_VISIBILITY_SOURCE}/framebuffer_clip_visibility.cpp")
+        message(FATAL_ERROR "RX7900_FRAMEBUFFER_CLIP_VISIBILITY_SOURCE must contain framebuffer_clip_visibility.cpp")
+    endif()
+    target_sources(win32k PRIVATE "${RX7900_FRAMEBUFFER_CLIP_VISIBILITY_SOURCE}/framebuffer_clip_visibility.cpp")
+    target_include_directories(win32k PRIVATE "${RX7900_FRAMEBUFFER_CLIP_VISIBILITY_SOURCE}")
+    target_compile_definitions(win32k PRIVATE RX7900_FRAMEBUFFER_CLIP_VISIBILITY)
+    if(RX7900_FRAMEBUFFER_DRAW_ESCAPE)
+        target_compile_definitions(win32k PRIVATE RX7900_FRAMEBUFFER_WINDOW_VISIBILITY)
+    endif()
+    set_target_properties(win32k PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED YES
+        WITH_CXX_EXCEPTIONS FALSE WITH_CXX_RTTI FALSE)
+endif()
+
+# Explicit temporary metadata tracing for retained window-DC diagnosis.
+option(RX7900_DRAW_ESCAPE_CLIP_TRACE "Trace locked DrawEscape clip metadata" OFF)
+if(RX7900_DRAW_ESCAPE_CLIP_TRACE)
+    target_compile_definitions(win32k PRIVATE RX7900_DRAW_ESCAPE_CLIP_TRACE)
+endif()
