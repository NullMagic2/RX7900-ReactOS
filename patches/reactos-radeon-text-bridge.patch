+# A source-pinned physical Radeon glyph bridge forwards only the locked
+# FreeType mask and the current DC clip to an identity-checked display DDI.
+option(RX7900_RADEON_TEXT_BRIDGE "Submit supported glyphs to radeondisp" OFF)
+set(RX7900_RADEON_TEXT_BRIDGE_SOURCE "" CACHE PATH "RX7900 native C++ source directory")
+if(RX7900_RADEON_TEXT_BRIDGE)
+    if(NOT EXISTS "${RX7900_RADEON_TEXT_BRIDGE_SOURCE}/radeon_text_engine.cpp" OR
+       NOT EXISTS "${RX7900_RADEON_TEXT_BRIDGE_SOURCE}/radeon_text_bridge.hpp")
+        message(FATAL_ERROR "RX7900_RADEON_TEXT_BRIDGE_SOURCE must contain the paired Radeon text bridge")
+    endif()
+    target_sources(win32k PRIVATE "${RX7900_RADEON_TEXT_BRIDGE_SOURCE}/radeon_text_engine.cpp")
+    target_include_directories(win32k PRIVATE "${RX7900_RADEON_TEXT_BRIDGE_SOURCE}")
+    target_compile_definitions(win32k PRIVATE RX7900_RADEON_TEXT_BRIDGE)
+    set_target_properties(win32k PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED YES
+        WITH_CXX_EXCEPTIONS FALSE WITH_CXX_RTTI FALSE)
+endif()
 target_link_libraries(win32k ${PSEH_LIB} dxguid libcntpr)
 
