; Module: lightning.reactos.pnp_package
; Purpose: Bind only the Lightning virtual PCI device to its NT5 transport.
; Created: 2026-10-21
; Architecture: System-device transport; does not replace the active display.
[Version]
Signature="$Windows NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=10/21/2026,0.1.0.1

[Manufacturer]
%Provider%=Models,NTx86,NTamd64

[Models.NTx86]
%Device%=Install,PCI\VEN_1234&DEV_11F1

[Models.NTamd64]
%Device%=Install,PCI\VEN_1234&DEV_11F1

[DestinationDirs]
DriverFiles=12

[Install.NT]
CopyFiles=DriverFiles

[Install.NT.HW]
AddReg=Security

[Security]
HKR,,Security,0x00000000,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[Install.NT.Services]
AddService=LightningNT5,0x00000002,Service

[Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\lightningnt5.sys

[DriverFiles]
lightningnt5.sys

[SourceDisksNames]
1=%Media%

[SourceDisksFiles]
lightningnt5.sys=1

[Strings]
Provider="QEMU Lightning development"
Device="Lightning NT5 host transport (experimental)"
ServiceName="Lightning NT5 bounded host transport"
Media="Lightning NT5 development package"
